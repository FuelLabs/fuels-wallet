{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": {
          "level": "warn"
        },
        "useHookAtTopLevel": "warn",
        "noUnsafeOptionalChaining": "warn"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noNonNullAssertedOptionalChain": "warn",
        "noDuplicateProperties": "warn",
        "useIterableCallbackReturn": "warn",
        "noArrayIndexKey": "warn",
        "noExplicitAny": "warn"
      },
      "complexity": {
        "noForEach": "warn"
      },
      "a11y": {
        "noSvgWithoutTitle": "warn",
        "useAriaPropsSupportedByRole": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5"
    }
  },
  "json": {
    "parser": {
      "allowTrailingCommas": true
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/.changeset",
      "!**/.vscode",
      "!**/scripts",
      "!**/node_modules",
      "!**/.turbo",
      "!**/build",
      "!**/dist",
      "!**/dist-crx",
      "!**/contracts",
      "!**/playwright-report",
      "!**/vite-*.d.ts",
      "!**/pnpm-lock.yaml"
    ]
  },
  "css": {
    "formatter": {
      "enabled": false
    }
  }
}
